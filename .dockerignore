# The CLI build needs only Go sources, dependency metadata and the embedded version.
# Keep local credentials, data, binaries and unrelated files out of build layers.
**
!go.mod
!go.sum
!cmd/
!cmd/cline-proxy/
!cmd/cline-proxy/*.go
!cmd/cline-proxy/VERSION
!cmd/cline-proxy/web/
!cmd/cline-proxy/web/css/
!cmd/cline-proxy/web/css/*.css
!cmd/cline-proxy/web/js/
!cmd/cline-proxy/web/js/*.js
!cmd/cline-proxy/web/templates/
!cmd/cline-proxy/web/templates/*.html
!cmd/cline-proxy/web/images/
cmd/cline-proxy/web/images/source/
!cmd/cline-proxy/web/images/*.png
!cmd/cline-proxy/web/images/*.jpg
